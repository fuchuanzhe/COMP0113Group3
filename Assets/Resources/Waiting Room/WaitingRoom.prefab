  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "1.\tComplete the tutorial in the waiting room before starting the game.\n\t2.\tAfter
    pressing the start button, all players will be transported to the kitchen scene.\n\t3.\tYour
    assigned role will be displayed for 3 seconds, after which the game will begin.\n\t4.\tYou
    may interact with and deform any objects in the scene (e.g., including large
    items such as the fridge).\n\t5.\tPlace collected letters onto the table; they
    will automatically attach to the surface.\n\t6.\tArrange letters on the table
    to form words, then press the validation button.\n\t7.\tIf the word is valid,
    the letters will disappear and points will be awarded to your team.\n\t8.\tIf
    the letters turn red, the word is invalid.\n\t9.\tWords formed using object names
    from the scene (e.g., \u201Capple\u201D) are not allowed; such letters will turn
    yellow and no points will be awarded.\n\t10.\tWhen the time expires, the team
    with the highest score wins the game."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
